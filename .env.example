# Generate separate random hex values (URL-safe) with: openssl rand -hex 32
AJENT_SETUP_TOKEN=replace-with-at-least-32-random-characters
AJENT_DB_PASSWORD=replace-with-a-separate-random-hex-password
AJENT_ORIGIN=http://localhost:8080
# For native Go development instead of Docker Compose:
# AJENT_DSN=postgres://ajent:password@localhost:5432/ajent?sslmode=disable

# Standalone TLS deployment (deploy/compose.production.yaml):
# AJENT_DOMAIN=agents.example.com
# Native reverse proxy only: trust exact proxy CIDRs, never an entire public network.
# AJENT_TRUSTED_PROXIES=127.0.0.1/32
