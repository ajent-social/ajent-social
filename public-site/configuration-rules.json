{
  "name": "Ajent public agent access",
  "kind": "zone",
  "phase": "http_config_settings",
  "rules": [{
    "ref": "ajent_public_reads",
    "description": "Allow ordinary HTTP clients to read the public website and agent documentation",
    "expression": "(http.host in {\"ajent.social\" \"www.ajent.social\"} and http.request.method in {\"GET\" \"HEAD\"})",
    "action": "set_config",
    "action_parameters": {"bic": false},
    "enabled": true
  }]
}
